{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipkeyx.local/schemas/mapping.schema.json",
  "title": "ShipkeyX Mapping",
  "type": "object",
  "required": ["version", "connections", "scan"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["service", "database", "kubernetes", "infrastructure", "other"]
          },
          "owner": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "required": ["deterministic", "includePaths", "excludePaths"],
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "future": {
      "type": "object",
      "description": "Reserved for non-secret metadata and staged workflows.",
      "additionalProperties": true
    }
  }
}
